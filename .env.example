# Postgres connection string; on Neon use the pooled URL for the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spendly

# Run `openssl rand -base64 32` to generate it; use a different value per environment
BETTER_AUTH_SECRET=
# The public URL of the app, without a trailing slash; unset on Vercel previews, which use VERCEL_BRANCH_URL
BETTER_AUTH_URL=http://localhost:3000
