# Postgres connection string; on Neon use the pooled URL for the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spendly

# Run `openssl rand -base64 32` to generate it; use a different value per environment
BETTER_AUTH_SECRET=
# The public URL of the app, without a trailing slash; unset on Vercel previews, which use VERCEL_BRANCH_URL
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in: an OAuth client from Google Cloud (Google Auth Platform -> Clients); set both or
# neither, and leave them unset on Vercel previews, whose changing hosts Google can't list
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email through Resend (resend.com -> API Keys, "Sending access"); unset, emails aren't sent
RESEND_API_KEY=
# The sender; until a domain is verified in Resend, the default delivers only to the Resend account's address
EMAIL_FROM="Spendly <onboarding@resend.dev>"
# Vercel Cron's bearer token for /api/cron/*: `openssl rand -base64 32`; unset, cron requests are refused
CRON_SECRET=
# Only for E2E runs: Playwright's web server sets the day the screens treat as today; refused on Vercel
E2E_TODAY=
